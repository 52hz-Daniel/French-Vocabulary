{
  "name": "tcf-vocabulary-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:import:listening": "tsx scripts/import-listening.ts data-private/generated/items-enriched.json",
    "db:import:core": "tsx scripts/import-core.ts data-private/generated/core-vocabulary-enriched.json",
    "db:import:catalog": "tsx scripts/import-catalog.ts data-private/generated/catalog-candidates.json",
    "db:verify": "tsx scripts/verify-db.ts data-private/generated/items-enriched.json",
    "db:queue:enrichment": "tsx scripts/queue-enrichment.ts",
    "db:review": "tsx scripts/review-content.ts",
    "db:promote-ready": "tsx scripts/promote-ready.ts",
    "db:enrich:submit": "tsx scripts/openai-enrichment-batch.ts submit",
    "db:enrich:sync": "tsx scripts/openai-enrichment-batch.ts sync",
    "test": "vitest run && python3 -m pytest python/tests",
    "test:web": "vitest run",
    "test:python": "python3 -m pytest python/tests",
    "ingest": "python3 -m python.ingest data-private/exam/listening/CO\\ 1.docx data-private/reviewed-senses.json data-private/generated/items.json",
    "candidates": "python3 -m python.candidates 'vocabulary resources/听力文本（42套）' data-private/generated/listening-candidates.json",
    "analyze:candidates": "python3 -m python.candidates 'vocabulary resources/听力文本（42套）' data-private/generated/listening-candidate-analysis.json --reviewed data-private/reviewed-senses.json --dictionary 'vocabulary resources/kaikki.org-dictionary-French.jsonl'",
    "promote:listening": "python3 -m python.promote 'vocabulary resources/听力文本（42套）' 'vocabulary resources/kaikki.org-dictionary-French.jsonl' data-private/generated/items.json --reviewed data-private/reviewed-senses.json --morphalou open-data/morphalou/Morphalou3.1.sqlite",
    "ocr:pdf": "python3 -m python.ocr_pdf 'vocabulary resources/TEF:TCF core-vocabulary.pdf' data-private/generated/core-vocabulary-ocr.json",
    "parse:core-vocabulary": "python3 -m python.ocr_candidates data-private/generated/core-vocabulary-ocr.json data-private/generated/core-vocabulary-review.json --dictionary 'vocabulary resources/kaikki.org-dictionary-French.jsonl'",
    "clean:core-vocabulary": "python3 -m python.clean_core data-private/generated/core-vocabulary-review.json data-private/generated/core-vocabulary-clean.json --lexique reference-private/lexique/Lexique400.tsv --dictionary 'vocabulary resources/kaikki.org-dictionary-French.jsonl'",
    "catalog:build": "python3 -m python.build_catalog --dictionary 'vocabulary resources/kaikki.org-dictionary-French.jsonl' --lexique reference-private/lexique/Lexique400.tsv --flelex reference-private/cefrlex/FleLex_TT_Beacco.tsv --wiktionary reference-private/wiktionary/raw-wiktextract-data.jsonl.gz --output data-private/generated/catalog-candidates.json",
    "resources:index": "python3 -m python.lexical_resources --target data-private/generated/items.json --target data-private/generated/core-vocabulary-clean.json --lexique reference-private/lexique/Lexique400.tsv --flelex reference-private/cefrlex/FleLex_TT_Beacco.tsv --wiktionary reference-private/wiktionary/raw-wiktextract-data.jsonl.gz --output data-private/generated/french-lexical-resources.json",
    "build:core-vocabulary": "python3 -m python.build_core_dataset data-private/generated/core-vocabulary-clean.json data-private/generated/french-lexical-resources.json data-private/generated/core-vocabulary.json --morphalou open-data/morphalou/Morphalou3.1.sqlite",
    "morphalou:download": "sh scripts/download-morphalou.sh",
    "morphalou:build": "python3 -m python.morphalou build open-data/morphalou/Morphalou3.1_formatCSV.zip open-data/morphalou/Morphalou3.1.sqlite",
    "translations:queue": "python3 -m python.translations queue data-private/generated/items.json data-private/generated/sentence-translations.json",
    "translations:merge": "python3 -m python.translations merge data-private/generated/items.json data-private/generated/sentence-translations.json data-private/generated/items-enriched.json",
    "translations:offline": "python3 -m python.translations offline data-private/generated/sentence-translations.json",
    "enrich:production": "python3 -m python.enrich data-private/generated/items.json data-private/generated/items-enriched.json data-private/generated/enrichment-cache.json"
  },
  "dependencies": {
    "@next/env": "^15.5.2",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.2",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
