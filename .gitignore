*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.odt
*.rtf
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.jsonl
*.ndjson

# Generated or downloaded media
*.mp3
*.m4a
*.wav
*.aac
*.mp4
*.mov
*.webm

