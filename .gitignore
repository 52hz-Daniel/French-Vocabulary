# Ignore Morphalou generated files
/open-data/morphalou/*.zip
/open-data/morphalou/*.sqlite
# Private source material and third-party reference assets
/data-private/
/reference-private/
/vocabulary resources/
/Reference App/
/Not in use plan and thoughts/

# Raw books, exam sources, exports, and large reference datasets
# Keep these local even if they are accidentally copied outside the folders above.
